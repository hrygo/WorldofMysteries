# ==============================================================================
# 《诡秘世界》(World of Mysteries) - Git 属性与文件类型规范 (.gitattributes)
# ==============================================================================

# 默认全局：自动推断文本并强制采用 LF 换行符（防止 macOS / Linux / Windows 换行抖动）
* text=auto eol=lf

# ------------------------------------------------------------------------------
# 1. 源代码文件与语法语义 Diff 驱动
# ------------------------------------------------------------------------------
*.swift         text diff=swift eol=lf
*.py            text diff=python eol=lf
*.pyi           text diff=python eol=lf
*.sh            text eol=lf
*.json          text eol=lf
*.schema.json   text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.sql           text eol=lf
*.md            text eol=lf
*.txt           text eol=lf

# ------------------------------------------------------------------------------
# 2. 二进制资源文件 (禁止 Git 尝试行转换与文本合并)
# ------------------------------------------------------------------------------
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.gif           binary
*.ico           binary
*.icns          binary
*.pdf           binary

# 音频与媒体资产
*.wav           binary
*.mp3           binary
*.m4a           binary
*.aac           binary
*.ogg           binary

# SQLite 与数据库文件
*.db            binary
*.db-wal        binary
*.db-shm        binary
*.sqlite        binary
*.sqlite3       binary

# 归档与可执行文件
*.zip           binary
*.tar.gz        binary
*.dylib         binary
*.a             binary
*.so            binary

# ------------------------------------------------------------------------------
# 3. GitHub Linguist 统计规则
# ------------------------------------------------------------------------------
fixtures/**     linguist-vendored
