{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterious.world/protocol/v1/engine_ipc.schema.json",
  "title": "MysteriousWorld Engine IPC Envelope v1.0",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "kind",
        "protocol_version",
        "trace_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "request",
            "response",
            "event"
          ]
        },
        "protocol_version": {
          "const": "1.0"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "kind",
        "protocol_version",
        "request_id",
        "trace_id",
        "method",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "request"
        },
        "protocol_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "kind",
        "protocol_version",
        "request_id",
        "trace_id",
        "status"
      ],
      "properties": {
        "kind": {
          "const": "response"
        },
        "protocol_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ]
        },
        "payload": {
          "type": "object"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "required": [
              "payload"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "not": {
              "required": [
                "payload"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "kind",
        "protocol_version",
        "trace_id",
        "stream_id",
        "sequence",
        "event",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "event"
        },
        "protocol_version": {
          "const": "1.0"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "story_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
