{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterious.world/schemas/v1/belief.schema.json",
  "title": "CharacterBelief",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "character_id",
    "worldline_id",
    "proposition_id",
    "confidence",
    "status",
    "source_ids",
    "revision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "character_id": {
      "type": "string",
      "minLength": 1
    },
    "worldline_id": {
      "type": "string",
      "minLength": 1
    },
    "proposition_id": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "active",
        "weakened",
        "contradicted",
        "abandoned"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "formed_world_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "revised_world_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
