{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterious.world/schemas/v1/action_intent.schema.json",
  "title": "ActionIntent",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "turn_id",
    "character_id",
    "intent",
    "adherence",
    "actions",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "character_id": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "adherence": {
      "enum": [
        "full",
        "partial",
        "reinterpret",
        "reject"
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "parameters": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "reason_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "speech_intent": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expected_costs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource",
          "amount"
        ],
        "properties": {
          "resource": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "perceived_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "risk",
          "level"
        ],
        "properties": {
          "risk": {
            "type": "string"
          },
          "level": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
