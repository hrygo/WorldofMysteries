{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterious.world/schemas/v1/common.schema.json",
  "title": "Common Definitions",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1
    },
    "Revision": {
      "type": "integer",
      "minimum": 0
    },
    "WorldTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "SchemaVersion": {
      "const": "1.0"
    },
    "StringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "EvidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
