{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterious.world/schemas/v1/character_memory.schema.json",
  "title": "CharacterMemory",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "character_id",
    "worldline_id",
    "memory_type",
    "summary",
    "importance",
    "source_ids",
    "retention"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string"
    },
    "character_id": {
      "type": "string"
    },
    "worldline_id": {
      "type": "string"
    },
    "memory_type": {
      "enum": [
        "canon",
        "episode",
        "emotional",
        "relationship",
        "identity"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "world_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "importance": {
      "type": "object",
      "required": [
        "overall",
        "emotional",
        "relationship",
        "identity"
      ],
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emotional": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "relationship": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "identity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "related_entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "retention": {
      "enum": [
        "permanent",
        "long",
        "normal",
        "decayable"
      ]
    },
    "active": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
