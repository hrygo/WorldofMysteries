        "--locked",
        "--extra",
        "dev",
        "pytest",
        "-q",
        "-k",
        "domain or resolver or contract or schema or pydantic"
      ],
      "expects": [
        "engine/tests/test_scaffolding.py",
        "engine/tests/test_contracts_schema.py",
        "engine/tests/test_contracts_pydantic.py"
      ]
    }
  ]
