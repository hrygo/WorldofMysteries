{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterious.world/schemas/v1/voice_identity_evidence.schema.json",
  "title": "VoiceIdentityEvidence",
  "description": "Immutable verification snapshot for one provider voice artifact and one exact execution scope. Machine checks, human identity review, and human naturalness review are independent facts; no single score implies publication.",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_digest",
    "provider_instance",
    "voice_id",
    "voice_revision",
    "execution",
    "reference",
    "output",
    "human",
    "publication",
    "rights",
    "created_at",
    "expires_at",
    "revoked",
    "cached_playback_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_id": {"$ref": "#/$defs/identifier"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "provider_instance": {"$ref": "#/$defs/identifier"},
    "voice_id": {"$ref": "#/$defs/identifier"},
    "voice_revision": {"$ref": "#/$defs/identifier"},
    "execution": {"$ref": "#/$defs/execution"},
    "reference": {"$ref": "#/$defs/reference_check"},
    "output": {"$ref": "#/$defs/output_check"},
    "human": {"$ref": "#/$defs/human_review"},
    "publication": {"$ref": "#/$defs/publication"},
    "rights": {"$ref": "#/$defs/rights"},
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "oneOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "revoked": {"type": "boolean"},
    "cached_playback_policy": {
      "enum": [
        "revocation_aware",
        "provider_decision"
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S",
      "not": {"pattern": "\u0000"}
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": ["pass", "fail", "not_run", "pending"]
    },
    "execution": {
      "type": "object",
      "required": [
        "model_id",
        "model_artifact_revision",
        "model_catalog_revision",
        "variant",
        "locale",
        "validation_policy_revision",
        "processing_fingerprint"
      ],
      "properties": {
        "model_id": {"$ref": "#/$defs/identifier"},
        "model_artifact_revision": {"$ref": "#/$defs/identifier"},
        "model_catalog_revision": {"$ref": "#/$defs/identifier"},
        "variant": {"$ref": "#/$defs/identifier"},
        "locale": {"$ref": "#/$defs/identifier"},
        "validation_policy_revision": {"$ref": "#/$defs/identifier"},
        "processing_fingerprint": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "reference_check": {
      "type": "object",
      "required": [
        "status",
        "audio_digest",
        "text_digest"
      ],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "audio_digest": {"$ref": "#/$defs/digest"},
        "text_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "output_check": {
      "type": "object",
      "required": [
        "status",
        "validation_id",
        "audio_digest",
        "text_digest"
      ],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "validation_id": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "audio_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "text_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "human_review": {
      "type": "object",
      "required": [
        "identity_status",
        "naturalness_status",
        "review_id",
        "reference_audio_digest",
        "validation_audio_digest"
      ],
      "properties": {
        "identity_status": {"$ref": "#/$defs/status"},
        "naturalness_status": {"$ref": "#/$defs/status"},
        "review_id": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "reference_audio_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "validation_audio_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": [
        "state",
        "published_revision"
      ],
      "properties": {
        "state": {"enum": ["published"]},
        "published_revision": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "required": [
        "allowed_usages",
        "scope_ref"
      ],
      "properties": {
        "allowed_usages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["dialogue", "narration"]}
        },
        "scope_ref": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
