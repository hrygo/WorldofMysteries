{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterious.world/schemas/v1/voice_foundry_state.schema.json",
  "title": "VoiceFoundryState",
  "description": "Public projection of one durable voice-supply task. Provider lifecycle and game-side task lifecycle are separate; published means the provider published, while ready means the current scope is durably bound and qualified.",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "request_id",
    "request_digest",
    "scope",
    "stage",
    "task_revision",
    "cancel_requested",
    "operation_status",
    "required_actions",
    "reason_code",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"$ref": "#/$defs/identifier"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "scope": {"$ref": "#/$defs/scope"},
    "stage": {
      "enum": [
        "requested",
        "previewing",
        "awaiting_selection",
        "provisioning",
        "validating",
        "awaiting_review",
        "published",
        "binding",
        "ready",
        "failed",
        "cancelled"
      ]
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "cancel_requested": {"type": "boolean"},
    "operation_status": {
      "enum": [
        "prepared",
        "unknown",
        "confirmed",
        "rejected"
      ]
    },
    "required_actions": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "select_candidate",
          "confirm_reference",
          "listen_reference",
          "listen_validation",
          "review",
          "retry",
          "cancel",
          "contact_architect"
        ]
      }
    },
    "reason_code": {
      "oneOf": [
        {"$ref": "#/$defs/identifier"},
        {"type": "null"}
      ]
    },
    "candidates": {
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S",
      "not": {"pattern": "\u0000"}
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "required": [
        "owner_id",
        "world_id",
        "worldline_id",
        "presentation_identity",
        "phase",
        "locale"
      ],
      "properties": {
        "owner_id": {"$ref": "#/$defs/identifier"},
        "world_id": {"$ref": "#/$defs/identifier"},
        "worldline_id": {"$ref": "#/$defs/identifier"},
        "presentation_identity": {"$ref": "#/$defs/identifier"},
        "phase": {"$ref": "#/$defs/identifier"},
        "locale": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "slot",
        "seed",
        "state",
        "preview_audio_digest",
        "provider_candidate_id",
        "provider_candidate_revision"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/identifier"},
        "slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "state": {
          "enum": [
            "previewing",
            "ready",
            "selected",
            "provisioning",
            "validating",
            "reviewing",
            "published",
            "failed",
            "cancelled"
          ]
        },
        "preview_audio_digest": {"$ref": "#/$defs/digest"},
        "provider_candidate_id": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "provider_candidate_revision": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
