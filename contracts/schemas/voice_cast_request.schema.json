{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysterious.world/schemas/v1/voice_cast_request.schema.json",
  "title": "VoiceCastRequest",
  "description": "Semantics-authorized, presentation-safe request for one durable voice identity. Context Compiler authorizes public audible information before this request exists; schema validation never substitutes for that semantic decision.",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "request_digest",
    "authorization_ref",
    "scope",
    "persona_revision",
    "usage",
    "locale",
    "public_traits",
    "voice_description",
    "reference_text",
    "validation_text",
    "provider_instance",
    "requested_execution_scope",
    "budget",
    "origin"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "authorization_ref": {"$ref": "#/$defs/identifier"},
    "scope": {"$ref": "#/$defs/scope"},
    "persona_revision": {"$ref": "#/$defs/identifier"},
    "usage": {"enum": ["dialogue", "narration"]},
    "locale": {"$ref": "#/$defs/locale"},
    "public_traits": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "voice_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "reference_text": {"$ref": "#/$defs/review_text"},
    "validation_text": {"$ref": "#/$defs/review_text"},
    "provider_instance": {"$ref": "#/$defs/identifier"},
    "requested_execution_scope": {
      "$ref": "#/$defs/execution_scope"
    },
    "budget": {"$ref": "#/$defs/budget"},
    "origin": {"$ref": "#/$defs/origin"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S",
      "not": {"pattern": "\u0000"}
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "scope": {
      "type": "object",
      "required": [
        "owner_id",
        "world_id",
        "worldline_id",
        "presentation_identity",
        "phase",
        "locale"
      ],
      "properties": {
        "owner_id": {"$ref": "#/$defs/identifier"},
        "world_id": {"$ref": "#/$defs/identifier"},
        "worldline_id": {"$ref": "#/$defs/identifier"},
        "presentation_identity": {"$ref": "#/$defs/identifier"},
        "phase": {"$ref": "#/$defs/identifier"},
        "locale": {"$ref": "#/$defs/locale"}
      },
      "additionalProperties": false
    },
    "execution_scope": {
      "type": "object",
      "required": [
        "model_id",
        "model_artifact_revision",
        "variant"
      ],
      "properties": {
        "model_id": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "model_artifact_revision": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "variant": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "review_text": {
      "type": "string",
      "minLength": 20,
      "maxLength": 240,
      "pattern": "\\S",
      "not": {"pattern": "\u0000"}
    },
    "budget": {
      "type": "object",
      "required": [
        "candidate_count",
        "timeout_ms",
        "max_audio_bytes"
      ],
      "properties": {
        "candidate_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "max_audio_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        }
      },
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "required": [
        "kind",
        "source_ref",
        "source_revision"
      ],
      "properties": {
        "kind": {"enum": ["content", "scene"]},
        "source_ref": {"$ref": "#/$defs/identifier"},
        "source_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
