{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldofmysteries.io/schemas/protocol/engine_ipc.schema.json",
  "title": "World of Mysteries IPC v1.0 — authoritative envelope",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "kind",
        "protocol_version",
        "request_id",
        "trace_id",
        "method",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "request"
        },
        "protocol_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "kind",
        "protocol_version",
        "request_id",
        "trace_id",
        "status"
      ],
      "properties": {
        "kind": {
          "const": "response"
        },
        "protocol_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ]
        },
        "payload": {
          "type": "object"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "required": [
              "payload"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "not": {
              "required": [
                "payload"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "kind",
        "protocol_version",
        "trace_id",
        "stream_id",
        "sequence",
        "event",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "event"
        },
        "protocol_version": {
          "const": "1.0"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "story_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "handshake_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_version",
        "app_build",
        "supported_protocols",
        "session_token"
      ],
      "properties": {
        "app_version": {
          "type": "string",
          "minLength": 1
        },
        "app_build": {
          "type": "string",
          "minLength": 1
        },
        "supported_protocols": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "session_token": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Per-launch credential, never log or persist."
        }
      }
    },
    "handshake_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_version",
        "engine_build",
        "python_version",
        "protocol_version",
        "capabilities"
      ],
      "properties": {
        "engine_version": {
          "type": "string",
          "minLength": 1
        },
        "engine_build": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "description": "Strict request/response/event wire contract; framing is a 4-byte big-endian length followed by UTF-8 JSON."
}
