{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldofmysteries.io/schemas/protocol/voice_delivery_cursor.schema.json",
  "title": "World of Mysteries voice delivery cursor control v1.0",
  "oneOf": [
    {"$ref": "#/$defs/get_request"},
    {"$ref": "#/$defs/update_request"},
    {"$ref": "#/$defs/response"}
  ],
  "$defs": {
    "evidence": {
      "enum": ["queued", "scheduled", "rendered_estimate", "measured_loopback"]
    },
    "stop_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "user_stop",
        "superseded",
        "device_route_change",
        "suspend",
        "provider_error",
        "media_error",
        "completed"
      ]
    },
    "cursor": {
      "type": "object",
      "required": [
        "track_id",
        "consumer_id",
        "unit_id",
        "generation",
        "source_offset_frames",
        "total_source_frames",
        "evidence",
        "stop_reason",
        "cursor_revision",
        "fully_output"
      ],
      "properties": {
        "track_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "consumer_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "generation": {"type": "integer", "minimum": 0},
        "source_offset_frames": {"type": "integer", "minimum": 0},
        "total_source_frames": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "evidence": {"$ref": "#/$defs/evidence"},
        "stop_reason": {"$ref": "#/$defs/stop_reason"},
        "cursor_revision": {"type": "integer", "minimum": 1},
        "fully_output": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "get_request": {
      "type": "object",
      "required": ["schema_version", "operation", "track_id", "consumer_id"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "operation": {"const": "get"},
        "track_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "consumer_id": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    },
    "update_request": {
      "type": "object",
      "required": [
        "schema_version",
        "operation",
        "track_id",
        "consumer_id",
        "unit_id",
        "generation",
        "source_offset_frames",
        "total_source_frames",
        "evidence",
        "stop_reason",
        "expected_cursor_revision"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "operation": {"const": "update"},
        "track_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "consumer_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "unit_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "generation": {"type": "integer", "minimum": 0},
        "source_offset_frames": {"type": "integer", "minimum": 0},
        "total_source_frames": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "evidence": {"$ref": "#/$defs/evidence"},
        "stop_reason": {"$ref": "#/$defs/stop_reason"},
        "expected_cursor_revision": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["schema_version", "cursor"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "cursor": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/cursor"}
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
