{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldofmysteries.io/schemas/protocol/story_session_control.schema.json",
  "title": "World of Mysteries trusted first-turn Story Session control v1.0",
  "description": "Typed payload contracts carried inside authenticated Engine IPC envelopes for the golden_001 trusted first-turn flow. JSON Schema validates wire shape; session ownership, scenario binding, envelope idempotency equality and revision-token provenance require service/DTO semantic validation.",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "allOf": [
        {"pattern": "\\S"},
        {"not": {"pattern": "\u0000"}}
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "allOf": [
        {"pattern": "\\S"},
        {"not": {"pattern": "\u0000"}}
      ]
    },
    "world_time": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "allOf": [
        {"pattern": "\\S"},
        {"not": {"pattern": "\u0000"}}
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775806
    },
    "raw_input": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "allOf": [
        {"pattern": "\\S"},
        {"not": {"pattern": "\u0000"}}
      ]
    },
    "scenario_id": {
      "const": "golden_001"
    },
    "mode": {
      "const": "golden_deterministic"
    },
    "session_status": {
      "enum": [
        "active",
        "suspended",
        "closing",
        "finalized",
        "cancelled",
        "recovery_required"
      ]
    },
    "protagonist_view": {
      "type": "object",
      "required": ["id", "display_name"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "display_name": {"$ref": "#/$defs/display_name"}
      },
      "additionalProperties": false
    },
    "scene_view": {
      "type": "object",
      "required": ["id", "location_id", "display_name"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "location_id": {"$ref": "#/$defs/identifier"},
        "display_name": {"$ref": "#/$defs/display_name"}
      },
      "additionalProperties": false
    },
    "clue_view": {
      "type": "object",
      "required": ["id", "display_name"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "display_name": {"$ref": "#/$defs/display_name"}
      },
      "additionalProperties": false
    },
    "public_story_session_view": {
      "type": "object",
      "required": [
        "schema_version",
        "scenario_id",
        "session_id",
        "mode",
        "status",
        "story_revision",
        "turn",
        "observed_store_revision",
        "world_time",
        "protagonist",
        "scene",
        "discovered_clues",
        "can_submit"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "scenario_id": {"$ref": "#/$defs/scenario_id"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "mode": {"$ref": "#/$defs/mode"},
        "status": {"$ref": "#/$defs/session_status"},
        "story_revision": {"$ref": "#/$defs/revision"},
        "turn": {"$ref": "#/$defs/revision"},
        "observed_store_revision": {"$ref": "#/$defs/revision"},
        "world_time": {"$ref": "#/$defs/world_time"},
        "protagonist": {"$ref": "#/$defs/protagonist_view"},
        "scene": {"$ref": "#/$defs/scene_view"},
        "discovered_clues": {
          "type": "array",
          "items": {"$ref": "#/$defs/clue_view"},
          "uniqueItems": true
        },
        "can_submit": {"type": "boolean"},
        "last_committed_turn_id": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": ["input_turn_id", "session_id", "turn_id", "status"],
      "properties": {
        "input_turn_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "turn_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["received", "cancelled", "committed"]},
        "committed_store_revision": {"$ref": "#/$defs/revision"},
        "committed_story_revision": {"$ref": "#/$defs/revision"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "committed"}},
            "required": ["status"]
          },
          "then": {
            "required": ["committed_store_revision", "committed_story_revision"]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["committed_store_revision"]},
                {"required": ["committed_story_revision"]}
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "committed_receipt": {
      "allOf": [
        {"$ref": "#/$defs/receipt"},
        {
          "properties": {"status": {"const": "committed"}},
          "required": ["status"]
        }
      ]
    },
    "entry_get_request": {
      "type": "object",
      "required": ["schema_version", "scenario_id"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "scenario_id": {"$ref": "#/$defs/scenario_id"}
      },
      "additionalProperties": false
    },
    "session_open_request": {
      "type": "object",
      "required": [
        "schema_version",
        "scenario_id",
        "open_request_id",
        "expected_store_revision"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "scenario_id": {"$ref": "#/$defs/scenario_id"},
        "open_request_id": {"$ref": "#/$defs/identifier"},
        "expected_store_revision": {"$ref": "#/$defs/expected_revision"}
      },
      "additionalProperties": false
    },
    "session_get_request": {
      "type": "object",
      "required": ["schema_version", "session_id"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "session_id": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "advice_submit_request": {
      "type": "object",
      "required": [
        "schema_version",
        "session_id",
        "input_turn_id",
        "raw_input",
        "expected_story_revision",
        "expected_store_revision"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "input_turn_id": {"$ref": "#/$defs/identifier"},
        "raw_input": {"$ref": "#/$defs/raw_input"},
        "expected_story_revision": {"$ref": "#/$defs/expected_revision"},
        "expected_store_revision": {"$ref": "#/$defs/expected_revision"}
      },
      "additionalProperties": false
    },
    "input_mode": {
      "description": "How the player delivered this turn. voice marks a SpeechRail transcript and is recorded on the durable receipt so a replay can never be reinterpreted as typed text.",
      "enum": ["text", "voice"]
    },
    "turn_submit_request": {
      "description": "story.turn.submit accepts whatever the player actually said, typed or spoken. It shares every durability and revision guard with story.advice.submit and adds an explicit input mode.",
      "type": "object",
      "required": [
        "schema_version",
        "session_id",
        "input_turn_id",
        "raw_input",
        "input_mode",
        "expected_story_revision",
        "expected_store_revision"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "input_turn_id": {"$ref": "#/$defs/identifier"},
        "raw_input": {"$ref": "#/$defs/raw_input"},
        "input_mode": {"$ref": "#/$defs/input_mode"},
        "expected_story_revision": {"$ref": "#/$defs/expected_revision"},
        "expected_store_revision": {"$ref": "#/$defs/expected_revision"}
      },
      "additionalProperties": false
    },
    "voice_render_recipe": {
      "description": "The exact sealed render recipe. The App replays it verbatim into voice.render and only supplies media_stream_id and generation itself, so a client can never choose the voice, its revision or the speed for a committed turn. The evidence fields record what a human approved and the exact model artifact that review heard, so the render cannot silently land on a different voice or a newer model; the catalogue revision is kept separate and must never stand in for the artifact revision. They are declared rather than required because the App treats them as optional and the parity test pins that choice: the Engine already refuses to seal or render a unit whose evidence is missing, so the wire contract describes what travels instead of re-deciding it.",
      "type": "object",
      "required": [
        "speech_unit_id",
        "turn_id",
        "story_revision",
        "narrative_block_id",
        "segment_index",
        "performance_plan_id",
        "spoken_text",
        "voice_id",
        "expected_voice_revision",
        "expected_model_revision",
        "speed",
        "language"
      ],
      "properties": {
        "speech_unit_id": {"$ref": "#/$defs/identifier"},
        "turn_id": {"$ref": "#/$defs/identifier"},
        "story_revision": {"$ref": "#/$defs/revision"},
        "narrative_block_id": {"$ref": "#/$defs/identifier"},
        "segment_index": {"type": "integer", "minimum": 0, "maximum": 131071},
        "performance_plan_id": {"$ref": "#/$defs/identifier"},
        "spoken_text": {"type": "string", "minLength": 1, "maxLength": 4096},
        "voice_id": {"$ref": "#/$defs/identifier"},
        "expected_voice_revision": {"$ref": "#/$defs/identifier"},
        "expected_model_revision": {"type": ["string", "null"], "maxLength": 256},
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Identifier of the stored evidence snapshot a human approved — never the evidence body itself."
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Content digest of that snapshot, so a rewritten record cannot pass as the reviewed one."
        },
        "expected_model_artifact_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The exact model artifact the review heard."
        },
        "expected_model_catalog_revision": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "description": "Catalogue revision the artifact was resolved from. Recorded separately so an old catalogue entry cannot pose as the current artifact."
        },
        "speed": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
        "language": {"type": ["string", "null"], "maxLength": 64}
      },
      "additionalProperties": false
    },
    "turn_delivery": {
      "description": "Post-COMMIT expression state. unavailable never means the turn was lost: the Domain commit already succeeded and stays durable, and only the audible rendering is missing. speech_units is the only per-segment view and is ordered by segment_index; a segment that could not be voiced is reported there rather than dropped, so one missing voice costs that segment its audio and nothing else. There is no single-segment mirror: a top-level field can only ever describe one of a turn's voices, and would eventually describe the wrong one.",
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"enum": ["ready", "unavailable"]},
        "narrative_block_id": {"$ref": "#/$defs/identifier"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 128},
        "speech_units": {
          "type": "array",
          "items": {"$ref": "#/$defs/segment_delivery"},
          "maxItems": 64
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "ready"}}, "required": ["state"]},
          "then": {
            "required": ["narrative_block_id"],
            "required": ["speech_units"],
            "properties": {"speech_units": {"minItems": 1}}
          }
        },
        {
          "if": {"properties": {"state": {"const": "unavailable"}}, "required": ["state"]},
          "then": {"required": ["reason"]}
        }
      ],
      "additionalProperties": false
    },
    "segment_delivery": {
      "description": "One persisted narrative segment's audio state. A segment that could not be voiced is reported here rather than dropped: a missing voice must cost that segment its audio and nothing else, so the rest of the turn still plays.",
      "type": "object",
      "required": ["segment_index", "state"],
      "properties": {
        "segment_index": {"type": "integer", "minimum": 0, "maximum": 131071},
        "state": {"enum": ["ready", "unavailable"]},
        "speech_unit_id": {"$ref": "#/$defs/identifier"},
        "spoken_text": {"type": "string", "minLength": 1, "maxLength": 4096},
        "render_recipe": {"$ref": "#/$defs/voice_render_recipe"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "ready"}}, "required": ["state"]},
          "then": {"required": ["speech_unit_id", "spoken_text", "render_recipe"]}
        },
        {
          "if": {"properties": {"state": {"const": "unavailable"}}, "required": ["state"]},
          "then": {"required": ["reason"]}
        }
      ],
      "additionalProperties": false
    },
    "advice_get_request": {
      "type": "object",
      "required": ["schema_version", "session_id", "input_turn_id"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "input_turn_id": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "entry_get_response": {
      "type": "object",
      "required": [
        "schema_version",
        "scenario_id",
        "mode",
        "supported_advice",
        "observed_store_revision"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "scenario_id": {"$ref": "#/$defs/scenario_id"},
        "mode": {"$ref": "#/$defs/mode"},
        "supported_advice": {
          "$comment": "The fixed advice accepted for the next turn. An empty list is the closed-run signal: the fixed scenario finished and no further submit is authorized.",
          "type": "array",
          "items": {"$ref": "#/$defs/raw_input"},
          "uniqueItems": true
        },
        "observed_store_revision": {"$ref": "#/$defs/revision"},
        "session": {"$ref": "#/$defs/public_story_session_view"},
        "pending_input_turn_id": {"$ref": "#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "session_open_response": {
      "type": "object",
      "required": [
        "schema_version",
        "session",
        "opened_store_revision",
        "replayed"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "session": {"$ref": "#/$defs/public_story_session_view"},
        "opened_store_revision": {"$ref": "#/$defs/revision"},
        "replayed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "session_get_response": {
      "type": "object",
      "required": ["schema_version", "session"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "session": {"$ref": "#/$defs/public_story_session_view"}
      },
      "additionalProperties": false
    },
    "advice_submit_response": {
      "type": "object",
      "required": ["schema_version", "receipt", "session", "replayed"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "receipt": {"$ref": "#/$defs/committed_receipt"},
        "session": {"$ref": "#/$defs/public_story_session_view"},
        "replayed": {"type": "boolean"},
        "delivery": {"$ref": "#/$defs/turn_delivery"}
      },
      "additionalProperties": false
    },
    "turn_submit_response": {
      "type": "object",
      "required": ["schema_version", "receipt", "session", "replayed"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "receipt": {"$ref": "#/$defs/committed_receipt"},
        "session": {"$ref": "#/$defs/public_story_session_view"},
        "replayed": {"type": "boolean"},
        "delivery": {"$ref": "#/$defs/turn_delivery"}
      },
      "additionalProperties": false
    },
    "advice_get_response": {
      "type": "object",
      "required": ["schema_version", "found", "replayed"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "found": {"type": "boolean"},
        "receipt": {"$ref": "#/$defs/receipt"},
        "session": {"$ref": "#/$defs/public_story_session_view"},
        "replayed": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"found": {"const": true}},
            "required": ["found"]
          },
          "then": {
            "required": ["receipt", "session"]
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["receipt"]},
                {"required": ["session"]}
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
