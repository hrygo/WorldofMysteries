{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldofmysteries.io/schemas/protocol/voice_render_control.schema.json",
  "title": "World of Mysteries sealed voice render control v1.0",
  "description": "Typed payloads carried inside authenticated Engine IPC envelopes. The request references an already committed/sealed speech unit and an already granted engine_to_app media stream; it does not authorize Domain mutation.",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/accepted"}
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "schema_version",
        "speech_unit_id",
        "turn_id",
        "story_revision",
        "narrative_block_id",
        "segment_index",
        "performance_plan_id",
        "spoken_text",
        "voice_id",
        "expected_voice_revision",
        "media_stream_id",
        "generation",
        "speed"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "speech_unit_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "story_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "narrative_block_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "segment_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "performance_plan_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "spoken_text": {"type": "string", "minLength": 1, "maxLength": 4096},
        "voice_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "expected_voice_revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "expected_model_revision": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "media_stream_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "speed": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 4.0
        },
        "language": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 32
        }
      },
      "additionalProperties": false
    },
    "accepted": {
      "type": "object",
      "required": [
        "schema_version",
        "render_id",
        "speech_unit_id",
        "media_stream_id",
        "generation",
        "state"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "render_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "speech_unit_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "media_stream_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "state": {"const": "accepted"}
      },
      "additionalProperties": false
    }
  }
}
